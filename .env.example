# ============================================================================
# Scientific Drawing 环境变量样例
# ============================================================================
# 复制为 .env 后再按需修改：cp .env.example .env

# ---- OpenAI 兼容 LLM 配置 ----
# 不配 OPENAI_API_KEY 时 AI 重建不可用，但启发式分析、画布编辑、导出仍可用。
OPENAI_API_KEY=
# 兼容自建反代或 Azure / OpenRouter 等同协议端点
OPENAI_BASE_URL=https://api.openai.com/v1
# AI 重建兜底模型；前端通过 /api/config 拿到模型列表
OPENAI_RECONSTRUCT_MODEL=gpt-4o

# ---- 运行产物保留 ----
# data/uploads、data/exports、data/scenes 中超过该天数的文件会在启动时清理
DATA_RETENTION_DAYS=14

# ---- 日志 ----
# debug / info / warn / error
LOG_LEVEL=info

# ---- 监听端口 ----
PORT=8787
